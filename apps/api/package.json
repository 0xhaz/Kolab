{
  "name": "@kolab/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "chain:setup": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/chain-setup.js",
    "devnet:flow": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/devnet-flow.js",
    "demo:clock": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/demo-clock.js",
    "seed:campaign": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/seed-campaign.js",
    "demo:brand": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/demo-brand.js",
    "demo:kits": "tsc -p scripts/tsconfig.build.json && node dist-scripts/scripts/demo-kits.js"
  },
  "dependencies": {
    "@kolab/ai": "workspace:*",
    "@kolab/sdk": "workspace:*",
    "@kolab/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@privy-io/node": "^0.35.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.5.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.7",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "~7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
