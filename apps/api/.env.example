PORT=4000
DATABASE_URL=postgresql://kolab:kolab@localhost:5433/kolab
CORS_ORIGINS=http://localhost:3000
PRIVY_APP_ID=
PRIVY_APP_SECRET=
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=wss://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# JSON byte array from solana-keygen (keys/fee-payer.json). Devnet only.
FEE_PAYER_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEMO_MODE=1
# JSON byte arrays from keys/verifier.json and keys/admin.json (demo faucet + clock only)
VERIFIER_SECRET=
DEMO_ADMIN_SECRET=
# from keys/chain-<target>.json (pnpm --filter @kolab/api chain:setup -- --target hosted)
PROGRAM_ID=
USDC_MINT=
INDEXER_POLL_MS=4000
MOCK_BASE_URL=http://localhost:4100
# random 24+ byte hex; the mock store (apps/mock) needs the same value
STORE_WEBHOOK_SECRET=
STILL_LIVE_AFTER_SECS=604800
# 64 hex chars (openssl rand -hex 32); shipping addresses are encrypted with it
ADDRESS_ENC_KEY=

# Cross-chain funding (Aurora Intents, powered by NEAR Intents). Aurora is mainnet-only:
# - simulated: devnet, deposit + swap simulated, escrow top-up is a real devnet tx
# - hybrid:    real Aurora swaps on mainnet through Kolab's relay wallet; escrow stays on devnet
# - aurora:    everything on mainnet (Intents Connect calls the program)
AURORA_MODE=simulated
# From https://studio.aurora.dev (needed for AURORA_MODE=aurora)
AURORA_API_KEY=
# Kolab's integrator fee on cross-chain flows, in bps (max 500; Aurora pays 60% of it to Kolab)
AURORA_APP_FEE_BPS=50
# Hybrid mode: Kolab's mainnet relay wallet (keys/relay-mainnet.json as a JSON byte array).
# It receives real bridged USDC and pays real cash-outs, so fund it with a few USDC + ~0.02 SOL only.
RELAY_SECRET=
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# Largest single hybrid flow and each user's 24h cash-out total, in USDC
HYBRID_MAX_USDC=10
# Emails allowed to cash out in hybrid mode (comma-separated). Set this on any public deployment.
HYBRID_CASHOUT_ALLOWLIST=
